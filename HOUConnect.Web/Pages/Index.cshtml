@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="main-feed-container">
    <h2 class="feed-title">Mới cập nhật</h2>

    <div class="song-list">
        @foreach (var item in Model.ListSongs)
        {
            <div class="song-item-row" onclick="playSong('@item.FileUrl', '@item.SongName', '@item.FullName')">

                <div class="col-uploader">
                    <div class="mini-avatar"></div>
                    <span class="uploader-name">@item.FullName</span>
                </div>

                <div class="col-action">
                    <button class="follow-link">Theo dõi</button>
                </div>

                <div class="col-song-title">
                    <span class="song-name">@item.SongName</span>
                </div>

                <div class="col-stats">
                    <div class="stat-box">
                        <i class="fa-solid fa-play"></i>
                        <span>12</span>
                    </div>
                    <div class="stat-box">
                        <i class="fa-regular fa-heart"></i>
                        <span>5</span>
                    </div>
                    <div class="stat-box comment-link">
                        <span>Bình Luận</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .welcome-text {
        margin-bottom: 25px;
        font-size: 26px;
    }

    .song-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 25px;
    }

    .music-card {
        background: #181818;
        padding: 15px;
        border-radius: 10px;
        transition: 0.3s ease;
        cursor: pointer;
    }

        .music-card:hover {
            background: #282828;
            transform: translateY(-5px);
        }

    .card-cover {
        width: 100%;
        aspect-ratio: 1/1;
        background: #333;
        border-radius: 6px;
        position: relative;
        overflow: hidden;
    }

    .play-overlay {
        position: absolute;
        bottom: 10px;
        right: 10px;
        font-size: 45px;
        color: #10b981;
        opacity: 0;
        transition: 0.3s;
    }

    .music-card:hover .play-overlay {
        opacity: 1;
        transform: translateY(-5px);
    }

    .song-name {
        font-weight: bold;
        margin-top: 12px;
    }

    .artist-name {
        font-size: 13px;
        color: #b3b3b3;
        margin-top: 5px;
    }
</style>