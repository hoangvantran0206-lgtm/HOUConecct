@page
@model HOUConnect.Web.Pages.UserManagementModel
@{
    // Dùng chung Layout chính để có Thanh nhạc và Sidebar tổng
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="admin-page-container">
    <div class="admin-sub-header">
        <div class="admin-nav-tabs">
            <a href="/Admin/UserManagement" class="tab-item active">👥 Quản lý User</a>
            <a href="/Admin/SongManagement" class="tab-item">🎵 Quản lý bài hát</a>
        </div>

        <form method="get" class="admin-search-bar">
            <input type="text" name="search" placeholder="Tìm tên, email..." value="@Model.CurrentSearch" />
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </div>

    <div class="admin-table-section">
        <h2 class="section-title">Danh sách thành viên</h2>

        <table class="hou-admin-table">
            <thead>
                <tr>
                    <th>NGƯỜI DÙNG</th>
                    <th>TRẠNG THÁI</th>
                    <th>NGÀY THAM GIA</th>
                    <th>THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="user-info-cell">
                                <div class="user-avatar-mini"></div>
                                <div class="user-text">
                                    <span class="user-fullname">@user.FullName</span>
                                    <span class="user-email">@user.Email</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="status-badge @(user.Status == 1 ? "status-active" : "status-locked")">
                                @(user.Status == 1 ? "Hoạt động" : "Bị khóa")
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.UserID">
                                <button class="btn-toggle @(user.Status == 1 ? "btn-lock" : "btn-unlock")">
                                    <i class="fa-solid @(user.Status == 1 ? "fa-user-slash" : "fa-user-check")"></i>
                                    @(user.Status == 1 ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>